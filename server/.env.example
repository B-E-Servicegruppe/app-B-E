# Beispielkonfiguration des Servers.
# Zum Verwenden diese Datei nach "server/.env" kopieren und Werte anpassen.
# (Für den lokalen Test funktioniert die App auch ganz ohne .env.)

PORT=4000

# Signaturschlüssel für die Anmeldung – im Echtbetrieb zwingend ändern!
# Zufallswert erzeugen z. B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-hier-einen-langen-zufallswert-eintragen
JWT_EXPIRES_IN=12h

# Adresse des Frontends (für den Link in der "Passwort vergessen"-E-Mail)
APP_BASE_URL=http://localhost:5173

# Erlaubte Herkunft für Browser-Anfragen; mehrere durch Komma trennen
CORS_ORIGIN=*

# Maximale Uploadgröße in Bytes (Standard 20 MB)
MAX_UPLOAD_BYTES=20971520
